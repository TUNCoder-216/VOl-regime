# Copy to .env (never commit .env). Used by: training (MLflow), docker compose, webhook listener.
DOCKERHUB_USERNAME=your-dockerhub-user
IMAGE_TAG=latest

MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-user>/vol-regime.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

MODEL_NAME=vol-regime
MODEL_ALIAS=champion

WEBHOOK_TOKEN=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
WEBHOOK_PORT=9000
